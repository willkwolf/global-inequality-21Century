{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GlobalWealthInequalityDatasetSchema",
  "description": "Esquema de datos para la visualización interactiva de desigualdad global de riqueza, enriquecido semánticamente bajo principios de Linked Open Data y JSON-LD.",
  "type": "OBJECT",
  "required": [
    "@context",
    "@type",
    "metadata",
    "formula_constants",
    "strata"
  ],
  "properties": {
    "@context": {
      "type": "STRING",
      "const": "https://schema.org"
    },
    "@type": {
      "type": "STRING",
      "const": "Dataset"
    },
    "metadata": {
      "type": "OBJECT",
      "required": [
        "title",
        "description",
        "author",
        "license",
        "total_adults_world",
        "total_billionaires",
        "last_updated_sources",
        "top_wealth_holder"
      ],
      "properties": {
        "title": { "type": "STRING" },
        "description": { "type": "STRING" },
        "author": { "type": "STRING" },
        "license": { "type": "STRING" },
        "total_adults_world": {
          "type": "INTEGER",
          "description": "Población adulta mundial estimada en millones de personas (ej. 5360 para 5,360 millones)."
        },
        "total_billionaires": {
          "type": "INTEGER",
          "description": "Recuento de billonarios confirmados a nivel mundial."
        },
        "last_updated_sources": {
          "type": "OBJECT",
          "required": ["ubs_report_date", "forbes_billionaires_date"],
          "properties": {
            "ubs_report_date": { "type": "STRING" },
            "forbes_billionaires_date": { "type": "STRING" }
          }
        },
        "top_wealth_holder": {
          "type": "OBJECT",
          "required": ["name_es", "name_en", "type"],
          "properties": {
            "name_es": { "type": "STRING" },
            "name_en": { "type": "STRING" },
            "type": {
              "type": "STRING",
              "enum": ["person", "organization", "other"]
            }
          }
        }
      }
    },
    "formula_constants": {
      "type": "OBJECT",
      "required": [
        "step_usd_value",
        "step_physical_height_meters"
      ],
      "properties": {
        "step_usd_value": {
          "type": "NUMBER",
          "description": "Valor monetario en USD que equivale a un escalón de escalera. Por defecto 8000 USD."
        },
        "step_physical_height_meters": {
          "type": "NUMBER",
          "description": "Altura física en metros de un escalón de escalera. Por defecto 0.15 metros (15 cm)."
        }
      }
    },
    "strata": {
      "type": "ARRAY",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "OBJECT",
        "required": [
          "id",
          "@type",
          "net_worth_range_usd",
          "population_ratio",
          "physical_analogy",
          "translations"
        ],
        "properties": {
          "id": {
            "type": "STRING",
            "pattern": "^s[1-8]$",
            "description": "ID del estrato en el DOM, de s1 ( Elon Musk) a s8 (Base)."
          },
          "@type": {
            "type": "STRING",
            "const": "StatisticalPopulation",
            "description": "Tipo semántico de schema.org para denotar que cada sección representa un subgrupo estadístico de población."
          },
          "net_worth_range_usd": {
            "type": "OBJECT",
            "required": ["min", "max", "average"],
            "properties": {
              "min": { "type": ["NUMBER", "null"] },
              "max": { "type": ["NUMBER", "null"] },
              "average": { "type": ["NUMBER", "null"] }
            }
          },
          "population_ratio": {
            "type": "OBJECT",
            "required": ["percentage", "ratio_phrase"],
            "properties": {
              "percentage": {
                "type": "NUMBER",
                "minimum": 0,
                "maximum": 100,
                "description": "Porcentaje de la población mundial en este estrato."
              },
              "ratio_phrase": {
                "type": "OBJECT",
                "required": ["es", "en"],
                "properties": {
                  "es": { "type": "STRING" },
                  "en": { "type": "STRING" }
                }
              }
            }
          },
          "physical_analogy": {
            "type": "OBJECT",
            "required": ["name_es", "name_en", "height_meters"],
            "properties": {
              "name_es": { "type": "STRING" },
              "name_en": { "type": "STRING" },
              "height_meters": {
                "type": "NUMBER",
                "minimum": 0,
                "description": "Altura calculada formalmente en metros."
              }
            }
          },
          "translations": {
            "type": "OBJECT",
            "required": ["es", "en"],
            "properties": {
              "es": {
                "type": "OBJECT",
                "required": ["headline", "caption", "aria"],
                "properties": {
                  "headline": { "type": "STRING" },
                  "caption": { "type": "STRING" },
                  "aria": { "type": "STRING" }
                }
              },
              "en": {
                "type": "OBJECT",
                "required": ["headline", "caption", "aria"],
                "properties": {
                  "headline": { "type": "STRING" },
                  "caption": { "type": "STRING" },
                  "aria": { "type": "STRING" }
                }
              }
            }
          },
          "svg_icon": {
            "type": "STRING",
            "description": "Código SVG completo opcional para representar la analogía física."
          }
        }
      }
    }
  }
}
